{
  "version": 2,
  "functions": {
    "api/sync.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/sync",
      "dest": "api/sync.js"
    }
  ],
  "cron": [
    {
      "path": "/api/sync",
      "schedule": "30 20 * * *",
      "timezone": "America/Guayaquil"
    }
  ]
}
